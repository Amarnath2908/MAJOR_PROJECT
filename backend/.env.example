# DesignVerse AI — Backend Environment Template
# ===============================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in every placeholder value below.
# 3. NEVER commit the real .env — it is git-ignored.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=DesignVerse AI
APP_VERSION=1.0.0
DEBUG=True

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security / JWT ────────────────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/designverse

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ── Upload Validation ─────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/bmp","image/tiff"]

# ── AI Models (GroundingDINO + SAM) ──────────────────────────────────────────
# After cloning the repo, run:  python scripts/download_models.py
# That script downloads the weights into models/ and sets these paths automatically.
#
# Windows example  (GroundingDINO installed at D:\AI\GroundingDINO):
#   GROUNDING_DINO_ROOT=D:\AI\GroundingDINO
#   GROUNDING_DINO_CONFIG_PATH=D:\AI\GroundingDINO\groundingdino\config\GroundingDINO_SwinT_OGC.py
#   GROUNDING_DINO_CHECKPOINT_PATH=D:\AI\GroundingDINO\weights\groundingdino_swint_ogc.pth
#   SAM_CHECKPOINT_PATH=D:\AI\GroundingDINO\weights\sam\sam_vit_b_01ec64.pth
#
# Linux / Docker example (weights downloaded into repo's models/ directory):
#   GROUNDING_DINO_ROOT=/path/to/GroundingDINO
#   GROUNDING_DINO_CONFIG_PATH=/path/to/GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py
#   GROUNDING_DINO_CHECKPOINT_PATH=/app/models/grounding_dino/groundingdino_swint_ogc.pth
#   SAM_CHECKPOINT_PATH=/app/models/sam/sam_vit_b_01ec64.pth
GROUNDING_DINO_ROOT=/path/to/GroundingDINO
GROUNDING_DINO_CONFIG_PATH=/path/to/GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_CHECKPOINT_PATH=/app/models/grounding_dino/groundingdino_swint_ogc.pth
SAM_CHECKPOINT_PATH=/app/models/sam/sam_vit_b_01ec64.pth
SAM_MODEL_TYPE=vit_b
DEVICE=cpu
GROUNDING_DINO_BOX_THRESHOLD=0.30
GROUNDING_DINO_TEXT_THRESHOLD=0.25

